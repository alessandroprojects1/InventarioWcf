@model InventarioMvc.ServiceReference1.DevolucionListado[]
@{
    ViewBag.Title = "Devoluciones";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2 class="mb-0">Devoluciones registradas</h2>
    @Html.ActionLink("+ Nueva devolución", "Create", "Devoluciones", null, new { @class = "btn btn-primary" })
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model == null || Model.Length == 0)
{
    <div class="alert alert-info">No hay devoluciones registradas.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>N°</th>
                <th>Fecha</th>
                <th>Venta</th>
                <th>Motivo</th>
                <th>Tipo</th>
                <th class="text-end">Monto devuelto</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.Id</td>
                    <td>@d.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@d.IdVenta</td>
                    <td>@d.MotivoDevolucion</td>
                    <td>
                        <span class="badge @(d.TipoDevolucion == "COMPLETA" ? "bg-success" : "bg-warning text-dark")">@d.TipoDevolucion</span>
                    </td>
                    <td class="text-end">S/ @d.MontoTotalDevuelto.ToString("N2")</td>
                    <td>@Html.ActionLink("Ver detalle", "Detalle", new { id = d.Id }, new { @class = "btn btn-sm btn-outline-primary" })</td>
                </tr>
            }
        </tbody>
    </table>
}
